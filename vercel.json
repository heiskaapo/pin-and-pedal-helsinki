{
  "version": 2,
  "cleanUrls": true,
  "public": true,
  "buildCommand": "node build-hosted.js",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/checkout",
      "dest": "/api/checkout.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}